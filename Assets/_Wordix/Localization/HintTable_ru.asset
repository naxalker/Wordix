  m_TableData:
  - m_Id: 6986928128
    m_Localized: "\u041A\u0410\u041A \u0418\u0413\u0420\u0410\u0422\u042C?"
    m_Metadata:
      m_Items: []
  - m_Id: 108891738112
    m_Localized: "<b>\u0422\u0432\u043E\u044F \u0446\u0435\u043B\u044C</b> \u2014
      \u0443\u0433\u0430\u0434\u0430\u0442\u044C \u0441\u043B\u043E\u0432\u043E \u0438\u0437
      <b>5 \u0431\u0443\u043A\u0432</b> \u0437\u0430 <b>6 \u043F\u043E\u043F\u044B\u0442\u043E\u043A</b>."
    m_Metadata:
      m_Items: []
  - m_Id: 195147599872
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u043A\u0430\u0436\u0434\u043E\u0439
      \u043F\u043E\u043F\u044B\u0442\u043A\u0438 \u0431\u0443\u043A\u0432\u044B \u0431\u0443\u0434\u0443\u0442
      \u043E\u043A\u0440\u0430\u0448\u0435\u043D\u044B \u0432 \u0440\u0430\u0437\u043D\u044B\u0435
      \u0446\u0432\u0435\u0442\u0430, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043C\u043E\u0447\u044C
      \u0442\u0435\u0431\u0435 \u043D\u0430\u0439\u0442\u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0435
      \u0441\u043B\u043E\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 431286915072
    m_Localized: "\u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440, \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044C,
      \u0447\u0442\u043E \u0437\u0430\u0433\u0430\u0434\u0430\u043D\u043D\u043E\u0435
      \u0441\u043B\u043E\u0432\u043E \u2014 <b>\"\u041A\u041E\u041B\u041E\u0421\"</b>."
    m_Metadata:
      m_Items: []
  - m_Id: 923412992000
    m_Localized: "1. \u0422\u044B \u0432\u0432\u043E\u0434\u0438\u0448\u044C \u043B\u044E\u0431\u043E\u0435
      \u0441\u043B\u043E\u0432\u043E \u0438\u0437 5 \u0431\u0443\u043A\u0432. \u041D\u0430\u043F\u0440\u0438\u043C\u0435\u0440,
      \u043C\u044B \u0432\u0432\u0435\u0434\u0435\u043C \u0441\u043B\u043E\u0432\u043E
      <b>\"\u0413\u041E\u0420\u041E\u0414\"</b>."
    m_Metadata:
      m_Items: []
  - m_Id: 5566385885184
    m_Localized: "\u0422\u0430\u043A \u043A\u0430\u043A \u0431\u0443\u043A\u0432\u044B
      <b>\u041E</b> \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044E\u0442
      \u0432 \u0441\u043B\u043E\u0432\u0435 \u0438 \u0441\u0442\u043E\u044F\u0442
      \u043D\u0430 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0445 \u043F\u043E\u0437\u0438\u0446\u0438\u044F\u0445,
      \u043E\u043D\u0438 \u0432\u044B\u0434\u0435\u043B\u044F\u044E\u0442\u0441\u044F
      <color=#538D4E><b>\u0417\u0415\u041B\u0415\u041D\u042B\u041C</b></color>."
    m_Metadata:
      m_Items: []
  - m_Id: 5742320160768
    m_Localized: "2. \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u043C \u0441\u043B\u043E\u0432\u043E\u043C
      \u0432\u0432\u0435\u0434\u0435\u043C \"\u0421\u0410\u041F\u0415\u0420\" (\u0431\u0443\u043A\u0432\u044B
      \u0401 \u0432 \u0438\u0433\u0440\u0435 \u0437\u0430\u043C\u0435\u043D\u0435\u043D\u044B
      \u043D\u0430 \u0415) . "
    m_Metadata:
      m_Items: []
  - m_Id: 6755106164736
    m_Localized: "\u0411\u0443\u043A\u0432\u0430 <b>\u0421</b> \u0435\u0441\u0442\u044C
      \u0432 \u043D\u0430\u0448\u0435\u043C \u0441\u043B\u043E\u0432\u0435, \u043D\u043E
      \u0441\u0442\u043E\u0438\u0442 \u043D\u0435 \u043D\u0430 \u0441\u0432\u043E\u0435\u043C
      \u043C\u0435\u0441\u0442\u0435, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u043E\u043D\u0430 \u0432\u044B\u0434\u0435\u043B\u0435\u043D\u0430 <color=#B59F3B><b>\u0416\u0415\u041B\u0422\u042B\u041C</b></color>. "
    m_Metadata:
      m_Items: []
  - m_Id: 7370964209664
    m_Localized: "3. \u041E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0435
      \u0431\u0443\u043A\u0432\u044B \u0431\u0443\u0434\u0443\u0442 \u0432\u044B\u0434\u0435\u043B\u0435\u043D\u044B
      <color=#3A3A3C><b>\u0421\u0415\u0420\u042B\u041C</b></color>. "
    m_Metadata:
      m_Items: []
  - m_Id: 7532784652288
    m_Localized: "<b>\u041F\u0440\u043E\u0431\u0443\u0439 \u0440\u0430\u0437\u043D\u044B\u0435
      \u043A\u043E\u043C\u0431\u0438\u043D\u0430\u0446\u0438\u0438, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439
      \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438 \u0438 \u043B\u043E\u0433\u0438\u043A\u0443!
      \u0421\u043B\u043E\u0432\u0430\u0440\u044F\u043C\u0438 \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u043D\u0435\u043B\u044C\u0437\u044F! \n\n\u0423\u0434\u0430\u0447\u0438 \u0438
      \u043F\u0443\u0441\u0442\u044C \u0437\u0435\u043B\u0435\u043D\u044B\u0445 \u0431\u0443\u043A\u0432
      \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u0431\u043E\u043B\u044C\u0448\u0435!</b>"
    m_Metadata:
      m_Items: []
  - m_Id: 7699080417280
    m_Localized: "\u0418\u0433\u0440\u0430\u0442\u044C"
    m_Metadata:
